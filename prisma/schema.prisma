// =============================================================================
// Union Records Management System — Prisma Schema
// PNG Department of Labour & Industrial Relations — Office of The Industrial Registrar
// Session 1: Foundation schema (User, Session, LoginAttempt, AuditLog)
// Session 2: Records Management (Union, Document, DocumentVersion, ComplianceRule)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  REGISTRAR
  INSPECTOR
  OFFICER
}

enum Severity {
  INFO
  WARNING
  CRITICAL
}

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  passwordHash         String
  role                 Role
  assignedUnionId      String?
  twoFactorSecret      String?
  twoFactorEnabled     Boolean        @default(false)
  failedLoginAttempts  Int            @default(0)
  lockedUntil          DateTime?
  disabled             Boolean        @default(false)
  sessions             Session[]
  loginAttempts        LoginAttempt[]
  auditLogs            AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  jti       String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ip        String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  userId    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String
  action     String
  entityType String
  entityId   String?
  beforeJson String?
  afterJson  String?
  severity   Severity @default(INFO)
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

// -----------------------------------------------------------------------------
// Session 2 — Records Management
// -----------------------------------------------------------------------------
// Four models covering: union registry, document metadata, non-destructive
// version history, and per-document-type compliance rules.
//
// Crucial principle carried into the API layer: compliance status is NEVER
// stored in these tables. The "Compliant / Expiring / Overdue / Missing"
// status is computed live on read (Session 3) via pure functions that read
// Document.currentVersionId → DocumentVersion.uploadedAt + ComplianceRule's
// renewalYears / retentionYrs. Caching a status field here would create a
// drift bug the first time a Registrar edits a rule.
// -----------------------------------------------------------------------------

enum UnionStatus {
  ACTIVE
  SUSPENDED
  DEREGISTERED
}

model ComplianceRule {
  id            String   @id @default(cuid())
  documentType  String   @unique // e.g., "Constitution", "Annual Return"
  required      Boolean  @default(true)
  renewalYears  Int      @default(1)
  retentionYrs  Int      @default(7)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Union {
  id             String       @id @default(cuid())
  unionName      String
  registrationNo String       @unique
  fileNumber     String?
  status         UnionStatus  @default(ACTIVE)
  address        String?
  contactPerson  String?
  contactEmail   String?
  contactPhone   String?
  remarks        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  documents      Document[]
}

model Document {
  id               String            @id @default(cuid())
  unionId          String
  documentType     String            // e.g., "Constitution", "Bylaws"
  currentVersionId String?
  disposedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  union            Union             @relation(fields: [unionId], references: [id], onDelete: Cascade)
  versions         DocumentVersion[]
}

model DocumentVersion {
  id             String   @id @default(cuid())
  documentId     String
  versionNumber  Int
  fileName       String
  filePath       String   // Relative path to the .bin file
  fileSize       Int
  checksum       String   // SHA-256 hash
  fileExtension  String?
  uploadedById   String?
  uploadedAt     DateTime @default(now())
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}
