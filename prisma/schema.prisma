// =============================================================================
// Union Records Management System — Prisma Schema
// PNG Department of Labour & Industrial Relations — Office of The Industrial Registrar
// Full schema: Sessions 1–7
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  REGISTRAR
  INSPECTOR
  OFFICER
}

enum Severity {
  INFO
  WARNING
  CRITICAL
}

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  passwordHash         String
  role                 Role
  assignedUnionId      String?
  twoFactorSecret      String?
  twoFactorEnabled     Boolean        @default(false)
  failedLoginAttempts  Int            @default(0)
  lockedUntil          DateTime?
  disabled             Boolean        @default(false)
  // Email notification opt-in (chunk: email notifications). Defaults to
  // true — users receive email notifications unless they explicitly opt
  // out in Account Security settings.
  emailNotificationsEnabled Boolean   @default(true)
  // SMS + WhatsApp notification fields. Referenced by notifications.ts +
  // me/preferences/route.ts. Defaults to false (opt-in).
  phone                        String?
  phoneVerifiedAt              DateTime?
  smsNotificationsEnabled      Boolean @default(false)
  whatsappNotificationsEnabled Boolean @default(false)
  // Session 4: password reset flow — token generated at create time or on
  // admin reset, expires after a window. The set-password route consumes
  // the token + the user's chosen password (NEVER accepted in the admin
  // API body per spec) and clears both fields.
  passwordResetToken   String?
  passwordResetExpires DateTime?
  sessions             Session[]
  loginAttempts        LoginAttempt[]
  auditLogs            AuditLog[]
  apiKeys              ApiKey[]
  // Session 6: back-relations for Task. Two FKs from Task → User exist
  // (assignee + creator), so Prisma requires named relations to
  // disambiguate which back-relation maps to which FK.
  assignedTasks        Task[]         @relation("TaskAssignee")
  createdTasks         Task[]         @relation("TaskCreator")
  reviewedDocuments    Document[]     @relation("DocumentReviewer")
  // Wave 3 / Item 1: documents this user gave FIRST approval to (two-person
  // approval workflow). The final APPROVED state is recorded via
  // reviewedDocuments (reviewedById) — this relation only tracks the FIRST
  // approver, who must be a DIFFERENT user from the final reviewer.
  firstApprovedDocuments Document[]   @relation("DocumentFirstApprover")
  legalHoldsPlaced     LegalHold[]    @relation("LegalHoldPlacer")
  legalHoldsLifted     LegalHold[]    @relation("LegalHoldLifter")
  dispositionsRequested DispositionRequest[] @relation("DispositionRequester")
  dispositionsExecuted  DispositionRequest[] @relation("DispositionExecutor")
  dispositionsCancelled DispositionRequest[] @relation("DispositionCanceller")
  notifications        Notification[]
  // Chunk 5: back-relations for ContactUpdateRequest. Two FKs from
  // ContactUpdateRequest → User exist (requester + reviewer), so Prisma
  // requires named relations to disambiguate which back-relation maps to
  // which FK. Same pattern as Task (assignee + creator).
  contactUpdatesRequested  ContactUpdateRequest[] @relation("ContactUpdateRequester")
  contactUpdatesReviewed   ContactUpdateRequest[] @relation("ContactUpdateReviewer")
  // Chunk 9: webhook endpoints created by this user
  webhookEndpoints         WebhookEndpoint[] @relation("WebhookEndpointCreator")
}

// -----------------------------------------------------------------------------
// Session 4 — Administration
// -----------------------------------------------------------------------------
// ApiKey: programmatic access tokens for scripts/integrations. The full key
// value is shown to the user EXACTLY ONCE on creation — only the SHA-256 hash
// + first-12-char prefix are persisted. The prefix lets the UI render
// "urm_a1b2c3d4..." without leaking the full key.
//
// Revocation is a soft-delete (revokedAt set) — the row stays for audit
// history. The disabled-user-API-key check (built into auth-guard in
// Session 1 Step 5) ensures a disabled owner's key immediately stops
// authenticating, even before the key itself is revoked.
// -----------------------------------------------------------------------------
model ApiKey {
  id          String    @id @default(cuid())
  name        String
  prefix      String    @unique // First 12 chars of the key
  keyHash     String    @unique // SHA-256 hash of the full key
  scopes      String    // Comma-separated scopes (e.g., "unions:read,documents:read")
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  createdById String?
  creator     User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  jti       String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ip        String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  userId    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String
  action     String
  entityType String
  entityId   String?
  beforeJson String?
  afterJson  String?
  severity   Severity @default(INFO)
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

// -----------------------------------------------------------------------------
// Session 2 — Records Management
// -----------------------------------------------------------------------------
// Four models covering: union registry, document metadata, non-destructive
// version history, and per-document-type compliance rules.
//
// Crucial principle carried into the API layer: compliance status is NEVER
// stored in these tables. The "Compliant / Expiring / Overdue / Missing"
// status is computed live on read (Session 3) via pure functions that read
// Document.currentVersionId → DocumentVersion.uploadedAt + ComplianceRule's
// renewalYears / retentionYrs. Caching a status field here would create a
// drift bug the first time a Registrar edits a rule.
// -----------------------------------------------------------------------------

enum UnionStatus {
  ACTIVE
  SUSPENDED
  DEREGISTERED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DispositionStatus {
  SCHEDULED
  CANCELLED
  EXECUTED
  BLOCKED
}

// Chunk 5 (Union self-service portal) — staged contact-info updates.
// Reps submit changes here; Registrar approves/rejects from the staff
// Reviews view. Approved requests mutate the parent Union row.
enum ContactUpdateStatus {
  PENDING
  APPROVED
  REJECTED
}

model ComplianceRule {
  id            String   @id @default(cuid())
  documentType  String   @unique
  required      Boolean  @default(true)
  renewalYears  Int      @default(1)
  retentionYrs  Int      @default(7)
  sensitive     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Union {
  id             String       @id @default(cuid())
  unionName      String
  registrationNo String       @unique
  fileNumber     String?
  status         UnionStatus  @default(ACTIVE)
  address        String?
  contactPerson  String?
  contactEmail   String?
  contactPhone   String?
  remarks        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  documents      Document[]
  tasks          Task[]
  // Chunk 5: staged contact-info updates submitted by union representatives.
  // Cascade-delete if the union is deleted (no orphaned update requests).
  contactUpdateRequests ContactUpdateRequest[]
}

model Document {
  id               String            @id @default(cuid())
  unionId          String
  documentType     String
  currentVersionId String?
  disposedAt       DateTime?
  snoozedUntil     DateTime?
  reviewStatus     ReviewStatus      @default(PENDING)
  reviewedById     String?
  reviewedAt       DateTime?
  rejectionReason  String?
  // Wave 3 / Item 1: Two-person approval workflow for document review.
  // When a Registrar gives first approval, firstApprovedAt + firstApprovedById
  // are set. The document STAYS in reviewStatus = PENDING until a DIFFERENT
  // Registrar confirms (sets reviewStatus = APPROVED). The first approver can
  // withdraw their approval (clears these fields, document stays PENDING).
  // Either approver can reject (sets reviewStatus = REJECTED + clears these).
  // We deliberately don't extend the ReviewStatus enum (PENDING_SECOND_APPROVAL)
  // to avoid touching every status check across the codebase — the
  // `firstApprovedAt != null && reviewStatus === PENDING` state IS the
  // "awaiting second approval" state.
  firstApprovedById String?
  firstApprovedAt   DateTime?
  archivedAt       DateTime?
  archivedReason   String?
  // Per-document public visibility — the Registrar controls which documents
  // appear on the public portal. Defaults to false (private). Only the
  // Registrar can toggle this via the staff dashboard.
  isPublic         Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  union            Union             @relation(fields: [unionId], references: [id], onDelete: Cascade)
  versions         DocumentVersion[]
  reviewedBy       User?             @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  firstApprovedBy  User?             @relation("DocumentFirstApprover", fields: [firstApprovedById], references: [id], onDelete: SetNull)
  legalHolds         LegalHold[]
  dispositionRequests DispositionRequest[]

  @@unique([unionId, documentType])
}

model DocumentVersion {
  id             String   @id @default(cuid())
  documentId     String
  versionNumber  Int
  fileName       String
  filePath       String
  fileSize       Int
  checksum       String
  fileExtension  String?
  textContent    String?
  uploadedById   String?
  uploadedAt     DateTime @default(now())
  effectiveDate  DateTime?
  supersedesVersionId String?
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  supersedes     DocumentVersion? @relation("DocumentVersionSupersedes", fields: [supersedesVersionId], references: [id], onDelete: SetNull)
  supersededBy   DocumentVersion[] @relation("DocumentVersionSupersedes")
}

// -----------------------------------------------------------------------------
// Session 5 — Oversight (snoozedUntil on Document for Retention rejection)
// Session 6 — Productivity (Task + Notification models)
// -----------------------------------------------------------------------------

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationType {
  COMPLIANCE
  TASK
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(PENDING)
  priority    String     @default("NORMAL")
  dueDate     DateTime?
  unionId     String?
  assigneeId  String?
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // FK relations — added in Chunk 5 (schema integrity).
  //
  // unionId is OPTIONAL (general tasks aren't tied to a union), so we use
  // onDelete: SetNull — deleting a Union nulls out the unionId of its
  // tasks but keeps the task rows (they may still be assignee-scoped).
  //
  // assigneeId is OPTIONAL (unassigned tasks exist), so onDelete: SetNull
  // — deleting a User nulls out the assigneeId of their tasks but keeps
  // the rows (the creator and audit trail still reference the task).
  //
  // createdById is REQUIRED (every task has a creator), so onDelete:
  // Restrict — deleting a User who created tasks fails loudly. This
  // prevents silent loss of provenance. (In practice, the user-delete
  // flow would reassign or soft-delete; for now the restrict acts as a
  // guardrail.)
  //
  // Two FKs to User (assignee + creator) require Prisma's named-relations
  // feature — see the back-relations on User (`assignedTasks`,
  // `createdTasks`).
  union       Union?     @relation(fields: [unionId], references: [id], onDelete: SetNull)
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator     User       @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
}

model Notification {
  id           String           @id @default(cuid())
  userId       String
  type         NotificationType
  title        String
  body         String
  dedupKey     String           @unique
  linkUrl      String?
  readAt       DateTime?
  emailSentAt  DateTime?
  emailError   String?
  // SMS/WhatsApp delivery tracking — referenced by notifications.ts but
  // were missing from the schema, causing PrismaClientValidationError.
  smsSentAt    DateTime?
  smsError     String?
  createdAt    DateTime         @default(now())

  // FK relation — added in Chunk 5. Cascade delete: when a User is deleted,
  // their notifications are deleted too (notifications are personal —
  // they have no value once the user is gone).
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LegalHold {
  id            String    @id @default(cuid())
  documentId    String
  reason        String
  placedById    String
  placedAt      DateTime  @default(now())
  liftedAt      DateTime?
  liftedById    String?
  createdAt     DateTime  @default(now())
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  placedBy      User      @relation("LegalHoldPlacer", fields: [placedById], references: [id], onDelete: Restrict)
  liftedBy      User?     @relation("LegalHoldLifter", fields: [liftedById], references: [id], onDelete: SetNull)
  @@index([documentId, liftedAt])
}

model DispositionRequest {
  id              String             @id @default(cuid())
  documentId      String
  status          DispositionStatus  @default(SCHEDULED)
  requestedById   String
  requestedAt     DateTime           @default(now())
  cooldownEndsAt  DateTime
  executedAt      DateTime?
  executedById    String?
  cancelledAt     DateTime?
  cancelledById   String?
  cancelReason    String?
  certificateJson String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  document        Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requestedBy     User               @relation("DispositionRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  executedBy      User?              @relation("DispositionExecutor", fields: [executedById], references: [id], onDelete: SetNull)
  cancelledBy     User?              @relation("DispositionCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  @@index([documentId, status])
}

// =============================================================================
// ComplianceSnapshot — chunk 4.2a: append-only daily history of the canonical
// compliance counts. One row per UTC calendar date (UNIQUE on `date`).
//
// SEMANTICS:
//   - Today's row is PROVISIONAL: re-triggering today overwrites it with
//     current values (intra-day changes stay current).
//   - Past rows are IMMUTABLE: any write attempt against a past date fails
//     loudly (error) and leaves the row untouched — drift alarm.
//   - Gaps are preserved: a day with no snapshot stays a gap forever (NO
//     interpolation, NO synthetic seeds outside test fixtures).
//
// DERIVATION:
//   All counts come from the SHARED canonical derivation:
//     fetchMatrixData() -> buildComplianceMatrix(data, now) -> tally statuses
//   The dashboard's `metrics.ts` `tallyComplianceCounts` operates on a
//   different cell shape but with the SAME status field — the reconciliation
//   test in `dashboard-snapshot.test.ts` proves end-to-end equality.
//
// DEFINITION STAMP:
//   `capturedWith` records the live config at capture time (expiringWindowDays,
//   requiredTypesCount). If the window or required types change later, old
//   rows still say what they were measured under — chart discontinuities
//   after a definition change are HONEST.
//
// Percentage is NOT stored — derivable from numerator/denominator (1.2 principle).
// =============================================================================

model ComplianceSnapshot {
  id               String   @id @default(cuid())
  // UTC calendar date (YYYY-MM-DD) — one row per day.
  date             String   @unique
  compliant        Int
  expiring         Int
  overdue          Int
  awaitingReview   Int      @default(0) // Added post-launch; old rows default to 0.
  missing          Int
  // Compliance rate numerator (COMPLIANT count) and denominator (COMPLIANT
  // + EXPIRING + OVERDUE + AWAITING_REVIEW + MISSING). NOT_APPLICABLE excluded.
  rateNumerator    Int
  rateDenominator  Int
  // Live config at capture time — JSON object:
  //   { expiringWindowDays: number, requiredTypesCount: number }
  // Stored as TEXT (Prisma has no native JSON for SQLite); serialized/
  // deserialized by the writer/selector. Allows old rows to honestly
  // declare "I was measured under a 90-day window with 13 required types"
  // even if those values change later.
  capturedWith     String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// =============================================================================
// Chunk 5 — Union self-service portal: ContactUpdateRequest
//
// Staged contact-info changes submitted from the /portal/contact view by
// union representatives. NOTE: the REPRESENTATIVE role + /portal app were
// removed in D7 — this model is now read-only on the staff side (Registrar
// review queue at /api/contact-requests) and has no producer endpoint. It
// is retained for now so any historical rows remain queryable; a future
// task can drop the model + review routes once confirmed unused.
//
// Each request is a SNAPSHOT of the requested new values for the four
// Officer-allowed fields on Union:
//   address, contactPerson, contactEmail, contactPhone
//
// Lifecycle:
//   1. Rep submits a request → status = PENDING, reviewedById = null
//   2. Registrar approves (POST /api/contact-requests/[id]/approve)
//      → the four fields are written to the Union row, status = APPROVED,
//        reviewedById = registrar.id, reviewedAt = now
//   3. OR Registrar rejects (POST /api/contact-requests/[id]/reject) with
//      a reason → status = REJECTED, reviewedById, reviewedAt, rejectionReason
//
// The request row is NEVER deleted — it's the audit trail for the change.
// Only ONE PENDING request per union at a time (enforced in the route, not
// at the DB level — SQLite doesn't make partial unique indexes easy, and
// the route-level check is sufficient given the low write volume).
//
// RESTRICTED FIELDS: unionName, registrationNo, fileNumber, status, remarks
// are NOT editable by reps. A request that tries to set them is rejected
// at the API layer (the route only accepts the four allowed fields).
// =============================================================================

model ContactUpdateRequest {
  id              String              @id @default(cuid())
  unionId         String
  requestedById   String
  // Snapshot of requested new values. NULL means "no change requested for
  // this field" — the rep can submit a partial update (e.g. just the phone
  // number) without re-stating unchanged fields. The approval route applies
  // only non-null values to the Union row.
  address         String?
  contactPerson   String?
  contactEmail    String?
  contactPhone    String?
  status          ContactUpdateStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  union           Union               @relation(fields: [unionId], references: [id], onDelete: Cascade)
  requestedBy     User                @relation("ContactUpdateRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy      User?               @relation("ContactUpdateReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([unionId, status])
  @@index([status])
}

// =============================================================================
// Chunk 9 — Webhook system for external integrations.
//
// WebhookEndpoint: a registered external URL that receives HTTP POST
// notifications when specific events occur (e.g., a union's compliance
// status changes). Each endpoint has a signing secret used to HMAC-sign
// the payload so the receiver can verify authenticity.
//
// WebhookDelivery: one row per delivery attempt. Tracks status (PENDING,
// DELIVERED, FAILED), attempt count, response code, + nextRetryAt for
// exponential backoff. Provides a full audit trail of webhook deliveries.
//
// EVENT TYPES: stored as a comma-separated string on WebhookEndpoint.events
// (same pattern as ApiKey.scopes). The dispatcher filters endpoints by
// whether the event type is in their list. An empty events string means
// "all events" (convenience for catch-all endpoints).
// =============================================================================

enum WebhookEventType {
  COMPLIANCE_STATUS_CHANGE
  DOCUMENT_UPLOADED
  DOCUMENT_REVIEWED
  CONTACT_UPDATE_SUBMITTED
  CONTACT_UPDATE_REVIEWED
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

model WebhookEndpoint {
  id          String   @id @default(cuid())
  url         String
  // Human-readable label for the admin UI (e.g., "DLIR Data Warehouse")
  name        String
  // Comma-separated WebhookEventType values. Empty string = all events.
  events      String   @default("")
  // HMAC-SHA256 signing secret (32 bytes, hex-encoded). Used to sign
  // payloads so the receiver can verify authenticity. Generated at
  // creation time, shown once, then only the hash is stored... actually,
  // we store the secret in plaintext because we need it to sign outbound
  // payloads. This is acceptable because:
  //   1. Only REGISTRAR can view/create endpoints
  //   2. The DB file is on the server, not exposed externally
  //   3. We need the raw secret to compute HMAC signatures
  secret      String
  active      Boolean  @default(true)
  createdById String?
  creator     User?    @relation("WebhookEndpointCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deliveries  WebhookDelivery[]

  @@index([active])
}

model WebhookDelivery {
  id              String               @id @default(cuid())
  endpointId      String
  eventId         String               // unique event ID (e.g., "evt_abc123") — sent in the payload
  eventType       WebhookEventType
  payload         String               // JSON string of the event payload
  status          WebhookDeliveryStatus @default(PENDING)
  attempts        Int                  @default(0)
  maxAttempts     Int                  @default(5)
  // HTTP response code from the last attempt (null if not yet attempted)
  lastResponseCode Int?
  // Error message from the last attempt (null on success)
  lastError       String?
  // When to next retry (null if delivered or exhausted retries)
  nextRetryAt     DateTime?
  // Timestamps of first attempt + final delivery/failure
  firstAttemptAt  DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  endpoint        WebhookEndpoint      @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, status])
  @@index([status, nextRetryAt])
  @@index([eventType])
}
