-   882→      const res = await fetch(`/api/unions/${unionId}/documents`, {
-   883→        method: "POST",
-   884→        credentials: "include",
-   885→        body: formData,
-   886→      });
-   887→      const data = await res.json();
-   888→      if (!res.ok) {
-   889→        toast.error(data.error || "Upload failed.");
-   890→        return;
-   891→      }
-   892→      toast.success(`Uploaded ${documentType} v${data.version.versionNumber}.`);
-   893→      onUploaded();
-   894→    } catch {
-   895→      toast.error("Network error. Please try again.");
-   896→    } finally {
-   897→      setUploading(false);
-   898→    }
-   899→  }
-   900→
