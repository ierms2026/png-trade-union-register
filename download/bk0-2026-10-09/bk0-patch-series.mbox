-   918→                {documentTypes.map((t) => (
-   919→                  <SelectItem key={t} value={t}>{t}</SelectItem>
-   920→                ))}
-   921→              </SelectContent>
-   922→            </Select>
-   923→          </div>
-   924→          <div className="space-y-2">
-   925→            <Label htmlFor="title">Title</Label>
-   926→            <Input
