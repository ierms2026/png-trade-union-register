-   467→   467→
-   468→   468→function EditUnionDialog({
-   469→   469→  union,
-   470→   470→  userRole,
-   471→   471→  onClose,
-   472→   472→  onSaved,
-   473→   473→}: {
-   474→   474→  union: Union;
-   475→   475→  userRole: string;
-   476→   476→  onClose: () => void;
-   477→   477→  onSaved: () => void;
-   478→   478→}) {
-   479→   479→  const isRegistrar = userRole === "REGISTRAR";
-   480→   480→  const isOfficer = userRole === "OFFICER";
-   481→   481→
-   482→   482→  const [unionName, setUnionName] = useState(union.unionName);
-   483→   483→  const [registrationNo, setRegistrationNo] = useState(union.registrationNo);
-   484→   484→  const [fileNumber, setFileNumber] = useState(union.fileNumber || "");
-   485→   485→  const [status, setStatus] = useState(union.status);
-   486→   486→  const [address, setAddress] = useState(union.address || "");
-   487→   487→  const [contactPerson, setContactPerson] = useState(union.contactPerson || "");
-   488→   488→  const [contactEmail, setContactEmail] = useState(union.contactEmail || "");
-   489→   489→  const [contactPhone, setContactPhone] = useState(union.contactPhone || "");
-   490→   490→  const [remarks, setRemarks] = useState(union.remarks || "");
-   491→   491→  const [saving, setSaving] = useState(false);
-   492→   492→
-   493→   493→  // Officer restricted fields (silently pinned server-side)
-   494→   494→  const restrictedFields = isOfficer
-   495→   495→    ? ["unionName", "registrationNo", "fileNumber", "status", "remarks"]
-   496→   496→    : [];
-   497→   497→
-   498→   498→  async function handleSave(e: FormEvent) {
-   499→   499→    e.preventDefault();
-   500→   500→    setSaving(true);
-   501→   501→    try {
-   502→   502→      const body: Record<string, unknown> = {};
-   503→   503→      if (isRegistrar) {
-   504→   504→        body.unionName = unionName;
-   505→   505→        body.registrationNo = registrationNo;
-   506→   506→        body.fileNumber = fileNumber || null;
-   507→   507→        body.status = status;
-   508→   508→        body.remarks = remarks || null;
-   509→   509→      }
-   510→   510→      body.address = address || null;
