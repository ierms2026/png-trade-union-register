DATABASE_URL=file:/home/z/my-project/db/custom.db

# Email/SMTP Configuration (for notifications)
# Configure with your SMTP provider (e.g. Gmail, SendGrid, Amazon SES, Mailgun)
# Example for Gmail: smtp.gmail.com, port 587, user=your-email@gmail.com, pass=app-specific-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@labour.gov.pg
SMTP_PASSWORD=change-this-to-your-smtp-password
SMTP_FROM_NAME=Register of Trade Unions
SMTP_FROM_EMAIL=noreply@labour.gov.pg

# Twilio SMS/WhatsApp Configuration (for mobile notifications)
# Get these from https://console.twilio.com/
# SMS_FROM: your Twilio phone number (E.164 format, e.g. +14155238886)
# WHATSAPP_FROM: your Twilio WhatsApp number (E.164 with whatsapp: prefix, e.g. whatsapp:+14155238886)
TWILIO_ACCOUNT_SID=change-this-to-your-account-sid
TWILIO_AUTH_TOKEN=change-this-to-your-auth-token
TWILIO_SMS_FROM=+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
