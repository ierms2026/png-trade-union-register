DATABASE_URL=file:/home/z/my-project/db/custom.db

# Disable the login lockout policy (3 failed attempts → 15-min lock) in
# preview/dev/staging so testers can iterate freely. This MUST be unset
# (or set to "false") in production — brute-force protection is required
# for a regulatory system.
DISABLE_LOGIN_LOCKOUT=true
