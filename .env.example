# Register of Trade Unions — environment variables
# =============================================================================
# Copy this file to .env and fill in real values for your deployment.
# Variable names only are listed here; see the comments for what each
# variable controls. Do NOT commit real values to the repository.
#
# The retention workflow is OFF by default. To enable it, set:
#   NEXT_PUBLIC_RETENTION_ENABLED=true
# (see the comment block below). When OFF, all retention/disposition/
# legal-hold surfaces return HTTP 404 with a generic "not found" body —
# no env var name is leaked in the response (decision D5).

# Database (SQLite path — absolute or repo-relative)
DATABASE_URL=

# Session cookie signing secret (use `openssl rand -hex 32`)
SESSION_SECRET=

# Cron secret for /api/cron/* routes (use `openssl rand -hex 32`)
CRON_SECRET=

# File storage root for uploaded documents (absolute path)
STORAGE_ROOT=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=

# Public app URL (optional — falls back to localhost:3000 if unset)
NEXT_PUBLIC_APP_URL=

# Public contact details for the Office of The Industrial Registrar
NEXT_PUBLIC_REGISTRAR_PHONE=
NEXT_PUBLIC_REGISTRAR_EMAIL=
NEXT_PUBLIC_REGISTRAR_ADDRESS=
NEXT_PUBLIC_REGISTRAR_HOURS=

# Retention workflow feature flag.
# When NOT set (or "false"), the retention/disposition/legal-hold workflow
# is completely hidden: the Retention Queue nav entry + view are removed,
# and the /api/retention, /api/legal-holds, /api/dispositions routes
# return 404 with a generic body. This prevents anyone from disposing of
# real records until the office is ready (retention rules configured,
# staff trained, policy signed off). See docs/decisions-and-defaults.md D5.
# To enable: NEXT_PUBLIC_RETENTION_ENABLED=true
NEXT_PUBLIC_RETENTION_ENABLED=

# Twilio (optional — SMS/WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
