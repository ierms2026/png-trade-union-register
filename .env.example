# Register of Trade Unions — environment variables
# For Vercel: set these in Settings → Environment Variables.

# Database — PostgreSQL (Vercel/Neon/Supabase). For local SQLite: file:./db/custom.db
DATABASE_URL=

# Session cookie signing secret (openssl rand -hex 32)
SESSION_SECRET=

# Cron secret for /api/cron/* routes (openssl rand -hex 32)
CRON_SECRET=

# Demo login password
DEMO_PASSWORD=

# File storage root (local: ./storage, Vercel: /tmp/storage)
STORAGE_ROOT=

# Email (optional — skipped if not set)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=

# Public app URL
NEXT_PUBLIC_APP_URL=

# Public contact details
NEXT_PUBLIC_REGISTRAR_PHONE=
NEXT_PUBLIC_REGISTRAR_EMAIL=
NEXT_PUBLIC_REGISTRAR_ADDRESS=
NEXT_PUBLIC_REGISTRAR_HOURS=

# Retention workflow flag (set to "true" to enable)
NEXT_PUBLIC_RETENTION_ENABLED=

# Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
